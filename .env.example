# Datadog
DD_API_KEY=your_datadog_api_key_here
DD_SITE=datadoghq.com
DD_DATA_STREAMS_ENABLED=true
DD_ENV=demo
# Agent runs locally on port 8126 by default -- change only if Agent is on a different host
DD_AGENT_HOST=localhost

# Kinesis (filled after CloudFormation deploy -- see Outputs)
KINESIS_STREAM_NAME=datadog-dsm-demo
KINESIS_STREAM_ARN=arn:aws:kinesis:us-east-1:ACCOUNT_ID:stream/datadog-dsm-demo

# AWS
AWS_REGION=us-east-1

# Demo controls
# Set CONSUMER_LAG_SECONDS to 2-5 to simulate lag buildup for the demo
CONSUMER_LAG_SECONDS=0
